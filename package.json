{
  "name": "tamreen",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "docker compose up -d db && turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "e2e": "pnpm --filter @tamreen/web e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @tamreen/api db:migrate",
    "db:seed": "pnpm --filter @tamreen/api db:seed",
    "content:lint": "pnpm --filter @tamreen/content content:lint",
    "content:sync": "pnpm --filter @tamreen/api content:sync",
    "metrics:report": "node scripts/not-yet.mjs metrics:report 5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
