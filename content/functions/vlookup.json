{
  "name": "VLOOKUP",
  "slug": "vlookup",
  "category": "lookup",
  "order": 5,
  "titleAr": "الدالة VLOOKUP: البحث العمودي",
  "summaryAr": "تبحث VLOOKUP عن قيمة في العمود الأول من جدول وتعيد قيمة من العمود الذي تحدده في الصف نفسه.",
  "introAr": "`VLOOKUP` تبحث عن قيمة، مثل رمز منتج، في العمود الأول من جدول، ثم تعيد قيمة من الصف نفسه في العمود الذي تحدده برقمه. استخدم `FALSE` للتطابق التام، و`TRUE` للبحث في شرائح مرتبة.",
  "syntax": "VLOOKUP(lookup_value, table_array, col_index_num, [range_lookup])",
  "args": [
    {
      "name": "lookup_value",
      "descAr": "ما تبحث عنه."
    },
    {
      "name": "table_array",
      "descAr": "الجدول، وعموده الأول هو عمود البحث."
    },
    {
      "name": "col_index_num",
      "descAr": "رقم العمود الذي تُعاد منه النتيجة، يُعدّ من أول الجدول."
    },
    {
      "name": "range_lookup",
      "descAr": "`FALSE` للتطابق التام، و`TRUE` (الافتراضي) للتطابق التقريبي.",
      "optional": true
    }
  ],
  "examples": [
    {
      "sheet": {
        "visible": "A1:C4",
        "cells": {
          "A1": "الرمز",
          "B1": "المنتج",
          "C1": "السعر",
          "A2": "P-101",
          "B2": "قلم",
          "C2": 2,
          "A3": "P-102",
          "B3": "دفتر",
          "C3": 7,
          "A4": "P-103",
          "B4": "مسطرة",
          "C4": 3
        }
      },
      "formula": "=VLOOKUP(\"P-102\",A2:C4,3,FALSE)",
      "result": 7,
      "explainAr": "سعر المنتج صاحب الرمز `P-102`."
    },
    {
      "sheet": {
        "visible": "A1:C4",
        "cells": {
          "A1": "الرمز",
          "B1": "المنتج",
          "C1": "السعر",
          "A2": "P-101",
          "B2": "قلم",
          "C2": 2,
          "A3": "P-102",
          "B3": "دفتر",
          "C3": 7,
          "A4": "P-103",
          "B4": "مسطرة",
          "C4": 3
        }
      },
      "formula": "=VLOOKUP(\"P-103\",A2:C4,2,FALSE)",
      "result": "مسطرة",
      "explainAr": "اسم المنتج من العمود الثاني."
    }
  ],
  "errors": [
    {
      "code": "#N/A",
      "causeAr": "القيمة غير موجودة في العمود الأول، أو فيها مسافة زائدة."
    },
    {
      "code": "#REF!",
      "causeAr": "رقم العمود أكبر من عدد أعمدة الجدول."
    }
  ],
  "faq": [
    {
      "qAr": "هل تبحث VLOOKUP في أي عمود؟",
      "aAr": "لا، تبحث في العمود الأول من النطاق فقط. للبحث في عمود آخر استخدم `XLOOKUP` أو `INDEX` مع `MATCH`."
    },
    {
      "qAr": "كيف أخفي الخطأ `#N/A`؟",
      "aAr": "ضع المعادلة داخل `IFERROR`، مثل `=IFERROR(VLOOKUP(...),\"غير موجود\")`."
    }
  ],
  "lessons": ["vlookup-exact", "vlookup-not-found", "vlookup-approximate"]
}
