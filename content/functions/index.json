  "category": "lookup",
  "order": 7,
  "titleAr": "الدالة INDEX: القيمة في موقع معين",
  "summaryAr": "تعيد INDEX القيمة الموجودة في صف وعمود محددين داخل نطاق.",
  "introAr": "`INDEX` تعيد ما في الخلية رقم كذا من {{نطاق}}: الصف الثاني، أو الصف الثالث والعمود الثاني. وتصبح قوية جدًا مع `MATCH` التي تعطيها رقم الصف.",
  "syntax": "INDEX(array, row_num, [column_num])",
  "args": [
    {
      "name": "array",
      "descAr": "النطاق."
    },
    {
      "name": "row_num",
      "descAr": "رقم الصف داخل النطاق."
    },
    {
      "name": "column_num",
      "descAr": "رقم العمود داخل النطاق، إذا كان أكثر من عمود.",
      "optional": true
    }
  ],
  "examples": [
