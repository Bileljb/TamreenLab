DATABASE_URL=postgresql://tamreen:tamreen@localhost:5432/tamreen?schema=public
PORT=4000
# Only the web server should reach the API (ADR 013). Use 0.0.0.0 only on a private network.
HOST=127.0.0.1
# Production only: proxies in front of the web server that append the client IP to
# X-Forwarded-For (a load balancer = 1; a CDN and a load balancer = 2). Required in production.
# TRUST_PROXY_HOPS=1
LOG_LEVEL=info
# Links in reminder emails, and their sender (ADR 011). Only the log transport exists so far.
PUBLIC_SITE_URL=http://localhost:3000
MAIL_TRANSPORT=log
MAIL_FROM=TamreenLab <noreply@localhost>
# AI formula assistant (ADR 012). Without a key it is off and learners see the static hint.
GROQ_API_KEY=
ASSISTANT_MODEL=qwen/qwen3.8-27b
ASSISTANT_TIMEOUT_MS=3500
ASSISTANT_USER_DAILY=20
ASSISTANT_IP_DAILY=40
ASSISTANT_DAILY_TOKENS=200000
ASSISTANT_MONTHLY_BUDGET_USD=2
ASSISTANT_PRICE_INPUT_PER_M=0.6
ASSISTANT_PRICE_OUTPUT_PER_M=1.2
