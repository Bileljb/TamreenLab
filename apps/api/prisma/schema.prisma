// Data model from docs/PLAN.md §3.4. Do not add subscription, premium or certificate fields (§8).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum LessonKind {
  CONCEPT
  PRACTICE
  SUMMARY
  CASE_STUDY
}

enum StepType {
  SELECT_CELL
  SELECT_RANGE
  ENTER_VALUE
  ENTER_FORMULA
  SHORTCUT
  MULTIPLE_CHOICE
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

model User {
  id            String           @id @default(cuid())
  email         String           @unique
  passwordHash  String
  displayName   String
  role          Role             @default(USER)
  locale        String           @default("ar")
  createdAt     DateTime         @default(now())
  attempts      Attempt[]
  progress      LessonProgress[]
  points        PointEvent[]
  streak        Streak?
  refreshTokens RefreshToken[]
}

model Track {
  id      String   @id @default(cuid())
  slug    String   @unique
  titleAr String
  order   Int
  lessons Lesson[]
}

model Lesson {
  id        String           @id @default(cuid())
  trackId   String
  track     Track            @relation(fields: [trackId], references: [id])
  slug      String           @unique
  order     Int
  kind      LessonKind
  titleAr   String
  summaryAr String
  minutes   Int
  status    PublishStatus    @default(DRAFT)
  seoJson   Json? // title, description, faq for the lesson page
  steps     Step[]
  progress  LessonProgress[]
}

model Step {
  id         String    @id @default(cuid())
  lessonId   String
  lesson     Lesson    @relation(fields: [lessonId], references: [id])
  /// Stable id from the content file; steps are matched by slug, never by order (ADR 005).
  slug       String
  order      Int
  type       StepType
  promptAr   String // markdown-lite, glossary terms marked
  sheetJson  Json // initial cells, visible range, formats
  checkJson  Json // check spec (see §3.5)
  hintAr     String?
  explainAr  String?
  basePoints Int       @default(300)
  attempts   Attempt[]

  @@unique([lessonId, order])
  @@unique([lessonId, slug])
}

model Attempt {
  id        String   @id @default(cuid())
  userId    String
  stepId    String
  correct   Boolean
  firstTry  Boolean
  timeMs    Int
  answer    Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  step      Step     @relation(fields: [stepId], references: [id])

  @@index([userId, stepId])
}

model LessonProgress {
  userId       String
  lessonId     String
  stepsDone    Int       @default(0)
  completedAt  DateTime?
  firstTryRate Float?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson       Lesson    @relation(fields: [lessonId], references: [id])

  @@id([userId, lessonId])
}

// Ledger: leaderboards are SUM() by day.
model PointEvent {
  id        String   @id @default(cuid())
  userId    String
  delta     Int
  reason    String
  day       DateTime @db.Date
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One award per reason (e.g. step:<id>): a step can never be paid twice (ADR 006).
  @@unique([userId, reason])
  @@index([day, userId])
}

model Streak {
  userId  String    @id
  current Int       @default(0)
  longest Int       @default(0)
  lastDay DateTime? @db.Date
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Refresh tokens, stored hashed. Rotation: each use revokes the token and issues a new one in the
// same family; a revoked token used again revokes the whole family (ADR 006).
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  family    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([family])
}

// Anonymous usage events for the launch metrics (ADR 007): no user id, no IP address.
model AnalyticsEvent {
  id         String   @id @default(cuid())
  name       String
  anonId     String
  sessionId  String
  lessonSlug String?
  stepSlug   String?
  day        DateTime @db.Date
  createdAt  DateTime @default(now())

  @@index([name, day])
  @@index([anonId])
}
