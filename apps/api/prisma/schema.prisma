// Data model from docs/PLAN.md §3.4. Do not add subscription, premium or certificate fields (§8).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum LessonKind {
  CONCEPT
  PRACTICE
  SUMMARY
  CASE_STUDY
}

enum StepType {
  SELECT_CELL
  SELECT_RANGE
  ENTER_VALUE
  ENTER_FORMULA
  SHORTCUT
  MULTIPLE_CHOICE
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

model User {
  id            String           @id @default(cuid())
  email         String           @unique
  passwordHash  String
  displayName   String
  role          Role             @default(USER)
  locale        String           @default("ar")
  /// Points a day the learner aims for (ADR 011).
  dailyGoal     Int              @default(900)
  /// Weekly reminder emails, only after an explicit opt-in (ADR 011).
  emailOptIn    Boolean          @default(false)
  emailOptInAt  DateTime?
  createdAt     DateTime         @default(now())
  attempts      Attempt[]
  progress      LessonProgress[]
  points        PointEvent[]
  streak        Streak?
  refreshTokens RefreshToken[]
  reviews       ReviewItem[]
  emails        EmailLog[]
}

model Track {
  id      String   @id @default(cuid())
  slug    String   @unique
  titleAr String
  order   Int
  lessons Lesson[]
}

model Lesson {
  id        String           @id @default(cuid())
  trackId   String
  track     Track            @relation(fields: [trackId], references: [id])
  slug      String           @unique
  order     Int
  kind      LessonKind
  titleAr   String
  summaryAr String
  minutes   Int
  status    PublishStatus    @default(DRAFT)
  seoJson   Json? // title, description, faq for the lesson page
  steps     Step[]
  progress  LessonProgress[]
}

model Step {
  id          String       @id @default(cuid())
  lessonId    String
  lesson      Lesson       @relation(fields: [lessonId], references: [id])
  /// Stable id from the content file; steps are matched by slug, never by order (ADR 005).
  slug        String
  order       Int
  type        StepType
  promptAr    String // markdown-lite, glossary terms marked
  sheetJson   Json // initial cells, visible range, formats
  checkJson   Json // check spec (see §3.5)
  hintAr      String?
  explainAr   String?
  basePoints  Int          @default(300)
  /// The sheet and check in each translated language: {en: {sheet, check}, fr: ...} (ADR 009).
  localesJson Json         @default("{}")
  attempts    Attempt[]
  reviews     ReviewItem[]
  hints       AssistantHint[]

  @@unique([lessonId, order])
  @@unique([lessonId, slug])
}

model Attempt {
  id        String   @id @default(cuid())
  userId    String
  stepId    String
  correct   Boolean
  firstTry  Boolean
  timeMs    Int
  answer    Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  step      Step     @relation(fields: [stepId], references: [id])

  @@index([userId, stepId])
}

model LessonProgress {
  userId       String
  lessonId     String
  stepsDone    Int       @default(0)
  completedAt  DateTime?
  firstTryRate Float?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson       Lesson    @relation(fields: [lessonId], references: [id])

  @@id([userId, lessonId])
}

// Ledger: leaderboards are SUM() by day.
model PointEvent {
  id        String   @id @default(cuid())
  userId    String
  delta     Int
  reason    String
  day       DateTime @db.Date
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One award per reason (e.g. step:<id>): a step can never be paid twice (ADR 006).
  @@unique([userId, reason])
  @@index([day, userId])
}

model Streak {
  userId        String    @id
  current       Int       @default(0)
  longest       Int       @default(0)
  lastDay       DateTime? @db.Date
  /// Optional streak freeze: covers one missed day, at most once a week (ADR 011).
  freezeEnabled Boolean   @default(false)
  freezeUsedOn  DateTime? @db.Date
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// "Review mistakes": a missed step waits here until it is reviewed correctly at each spacing (ADR 011).
model ReviewItem {
  userId String
  stepId String
  box    Int      @default(0)
  dueDay DateTime @db.Date
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  step   Step     @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@id([userId, stepId])
  @@index([userId, dueDay])
}

// One row per email sent; the unique key stops a second weekly reminder in the same week.
model EmailLog {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  periodKey String
  sentAt    DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, periodKey])
}

// Refresh tokens, stored hashed. Rotation: each use revokes the token and issues a new one in the
// same family; a revoked token used again revokes the whole family (ADR 006).
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  family    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([family])
}

// Anonymous usage events for the launch metrics (ADR 007): no user id, no IP address.
model AnalyticsEvent {
  id         String   @id @default(cuid())
  name       String
  anonId     String
  sessionId  String
  lessonSlug String?
  stepSlug   String?
  /// The page language (ar, en, fr); null for events recorded before languages existed.
  locale     String?
  day        DateTime @db.Date
  createdAt  DateTime @default(now())

  @@index([name, day])
  @@index([anonId])
}

// AI formula assistant (ADR 012). Cached explanations, one per (step, language, formula). Content
// sync drops a lesson's cached explanations whenever it rewrites that lesson's steps.
model AssistantHint {
  id         String              @id @default(cuid())
  stepId     String
  locale     String
  /// The formula in the checker's canonical spelling (formulaKey).
  formulaKey String
  code       String
  text       String
  model      String
  createdAt  DateTime            @default(now())
  step       Step                @relation(fields: [stepId], references: [id], onDelete: Cascade)
  feedback   AssistantFeedback[]

  @@unique([stepId, locale, formulaKey])
}

// One row per hint request, for the daily quotas, the token cap, the spend cap and latency. No user
// id and no IP address: both are keyed with an HMAC, so the rows outlive a deleted account without
// pointing to anyone.
model AssistantCall {
  id           String   @id @default(cuid())
  day          DateTime @db.Date
  userKey      String?
  ipKey        String
  /// ai, cached, or a fallback reason (QUOTA, BUDGET, UNAVAILABLE, UNSAFE, DISABLED).
  outcome      String
  /// True when the model was called (quotas count these; cache hits are free).
  calledModel  Boolean
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costMicros   Int      @default(0)
  latencyMs    Int
  createdAt    DateTime @default(now())

  @@index([day, userKey])
  @@index([day, ipKey])
  @@index([createdAt])
}

// Helpful / not helpful, kept for review. One vote per hint and voter (an HMAC of the user or IP).
model AssistantFeedback {
  hintId    String
  voter     String
  helpful   Boolean
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  hint      AssistantHint @relation(fields: [hintId], references: [id], onDelete: Cascade)

  @@id([hintId, voter])
}
